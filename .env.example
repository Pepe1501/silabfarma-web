# --- Dipakai oleh /api/*.js (server, di-set di Vercel Project Settings > Environment Variables) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-dengan-service-role-key-dari-supabase

# --- Dipakai oleh index.html (browser, hanya untuk login admin via Supabase Auth) ---
# anon key AMAN untuk ditaruh di frontend (bukan rahasia), tapi service role key TIDAK.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-dengan-anon-public-key-dari-supabase
