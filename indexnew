            if (isCanvasBlank(canvasGanti)) { Swal.fire('Tanda Tangan Kosong', 'Silakan berikan tanda tangan Anda di dalam kotak yang tersedia.', 'warning'); return; }

            let hasEmptyQty = false;
            cartGanti.forEach(item => { if (item.qty === "" || isNaN(item.qty)) { item.qty = 1; hasEmptyQty = true; } });
            if (hasEmptyQty) { renderKatalogGantiMini(); renderCartGanti(); }

            const now = new Date();
            const batas = new Date();
            batas.setDate(batas.getDate() + 7);

            const payload = {
                nama: document.getElementById('ganti-nama').value.trim(),
                nim: document.getElementById('ganti-nim').value.trim(),
                kelas: document.getElementById('ganti-kelas').value.trim(),
                telp: document.getElementById('ganti-telp').value.trim(),
                merk: document.getElementById('ganti-merk').value.trim(),
                keterangan: document.getElementById('ganti-keterangan').value.trim(),
                tanggalLapor: formatTanggalIndo(now),
                batasWaktu: formatTanggalIndo(batas),
                signature: canvasGanti.toDataURL('image/png'),
                items: cartGanti.map(item => ({ idAlat: item.id, namaAlat: item.nama, jumlah: item.qty, satuan: item.satuan }))
            };

            document.getElementById('loading-text').innerText = "Membuat PDF & Menyimpan...";
            document.getElementById('loading-overlay').style.display = 'flex';
            document.getElementById('loading-overlay').style.opacity = '1';

            gsRun('submitGantiAlatMulti', payload)
                .then((response) => {
                    document.getElementById('loading-overlay').style.opacity = '0';
                    setTimeout(() => { document.getElementById('loading-overlay').style.display = 'none'; }, 500);

                    if (response && response.pdfBase64) {
                        const link = document.createElement('a');
                        link.href = "data:application/pdf;base64," + response.pdfBase64;
                        link.download = response.pdfName || "Laporan_Ganti_Alat.pdf";
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                    }

                    Swal.fire({
                        title: 'Laporan Terkirim!',
                        html: `Batas waktu penggantian: <b>${payload.batasWaktu}</b>`,
                        icon: 'success',
                        confirmButtonColor: '#d97706'
                    }).then(() => {
                        document.getElementById('ganti-form').reset();
                        clearSignatureGanti();
                        cartGanti = []; renderCartGanti(); renderKatalogGantiMini();
                        setGantiBatasWaktu();
                        fetchData(false);
                    });
                })
                .catch((err) => {
                    document.getElementById('loading-overlay').style.opacity = '0';
                    setTimeout(() => { document.getElementById('loading-overlay').style.display = 'none'; }, 500);
                    Swal.fire('Gagal Menyimpan', (err && err.message) || String(err), 'error');
                });
        }

        function isGantiTerlambat(record) {
            if (record.status === 'Sudah Diganti') return false;
            const parts = record.batasWaktu.split(' ');
            const bulanMap = {Januari:0,Februari:1,Maret:2,April:3,Mei:4,Juni:5,Juli:6,Agustus:7,September:8,Oktober:9,November:10,Desember:11};
            const batasDate = new Date(parseInt(parts[2],10), bulanMap[parts[1]], parseInt(parts[0],10));
            return new Date() > batasDate;
        }

        function renderRiwayatGanti() {
            const tbody = document.getElementById('riwayat-ganti-table-body');
            if (!tbody) return;
            tbody.innerHTML = '';

            if (GANTI_DATA.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="p-4 text-center text-slate-500 text-xs">Belum ada laporan penggantian alat.</td></tr>`;
                return;
            }

            GANTI_DATA.forEach((record) => {
                const terlambat = isGantiTerlambat(record);
                let statusBadge = '<span class="bg-amber-100 text-amber-700 px-2 py-1 rounded-md text-[10px] font-bold">Menunggu Penggantian</span>';
                if (record.status === 'Sudah Diganti') {
                    statusBadge = '<span class="bg-emerald-100 text-emerald-700 px-2 py-1 rounded-md text-[10px] font-bold">Sudah Diganti</span>';
                } else if (terlambat) {
                    statusBadge = '<span class="bg-rose-100 text-rose-700 px-2 py-1 rounded-md text-[10px] font-bold">Terlambat</span>';
                }

                const actionHtml = record.status === 'Sudah Diganti'
                    ? '<span class="text-[10px] text-slate-400"><i class="fa-solid fa-check-circle mr-1"></i>Selesai</span>'
                    : `<button onclick="markGantiSelesai(${record.rowIndex})" class="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 px-3 py-1.5 rounded-lg text-[10px] font-bold transition"><i class="fa-solid fa-check mr-1"></i>Tandai Sudah Diganti</button>`;

                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50 transition">
                        <td class="p-4 text-xs text-slate-500">${record.tanggalLapor}</td>
                        <td class="p-4 text-xs font-semibold text-slate-700">${record.nama}<br><span class="text-slate-400 font-normal">${record.nim}</span></td>
                        <td class="p-4 text-xs text-slate-600">${record.kelas}</td>
                        <td class="p-4 text-xs text-slate-600">${record.alatNama} (${record.jumlah})</td>
                        <td class="p-4 text-xs text-slate-600">${record.merk || '-'}</td>
                        <td class="p-4 text-xs text-slate-600 max-w-[160px] truncate" title="${record.keterangan}">${record.keterangan}</td>
                        <td class="p-4 text-xs ${terlambat ? 'text-rose-600 font-bold' : 'text-slate-600'}">${record.batasWaktu}</td>
                        <td class="p-4">${statusBadge}</td>
                        <td class="p-4">${actionHtml}</td>
                    </tr>`;
            });
        }

        function markGantiSelesai(rowIndex) {
            const record = GANTI_DATA.find(r => r.rowIndex === rowIndex);
            if (!record || record.status === 'Sudah Diganti') return;

            Swal.fire({
                title: 'Tandai Sudah Diganti?',
                html: `Alat <b>${record.alatNama}</b> (${record.jumlah} unit) dari <b>${record.nama}</b> akan ditambahkan kembali ke stok total.`,
                icon: 'question', showCancelButton: true,
                confirmButtonColor: '#059669', cancelButtonColor: '#94a3b8', confirmButtonText: 'Ya, Sudah Diganti'
            }).then((result) => {
                if (!result.isConfirmed) return;

                gsRun('markGantiAlatSelesai', rowIndex)
                    .then(() => {
                        Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Stok alat diperbarui', showConfirmButton: false, timer: 1500 });
                        fetchData(false);
                    })
                    .catch((err) => {
                        Swal.fire('Gagal Memperbarui', (err && err.message) || String(err), 'error');
                    });
            });
        }

        function updateBadgeGanti() {
            const badge = document.getElementById('badge-ganti');
            if (!badge) return;
            const pending = GANTI_DATA.filter(r => r.status !== 'Sudah Diganti').length;
            badge.innerText = pending;
            badge.classList.toggle('opacity-50', pending === 0);
        }
    </script>
</body>
</html>
