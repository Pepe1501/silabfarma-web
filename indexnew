        function initSignaturePad() {
            canvas = document.getElementById('signature-pad');
            canvasAlat = document.getElementById('signature-pad-alat');
            canvasGanti = document.getElementById('signature-pad-ganti');

            function setupCanvas(cv) {
                if (!cv) return { context: null, resizeFn: null };
                const context = cv.getContext('2d');
                function resizeCanvas() {
                    const ratio = Math.max(window.devicePixelRatio || 1, 1);
                    cv.width = cv.offsetWidth * ratio;
                    cv.height = cv.offsetHeight * ratio;
                    context.scale(ratio, ratio);
                    context.lineWidth = 2.5;
                    context.lineCap = 'round';
                    context.lineJoin = 'round';
                    context.strokeStyle = '#000000';
                }
                window.addEventListener("resize", resizeCanvas);
                resizeCanvas();
                return { context, resizeFn: resizeCanvas };
            }

            const mainSetup = setupCanvas(canvas);
            ctx = mainSetup.context;
            resizeMainCanvas = mainSetup.resizeFn;

            const alatSetup = setupCanvas(canvasAlat);
            ctxAlat = alatSetup.context;
            resizeAlatCanvas = alatSetup.resizeFn;

            const gantiSetup = setupCanvas(canvasGanti);
            ctxGanti = gantiSetup.context;
            resizeGantiCanvas = gantiSetup.resizeFn;

            if (canvas) {
                canvas.addEventListener('mousedown', (e) => startDrawing(e, canvas, ctx, 'main'));
                canvas.addEventListener('mousemove', (e) => draw(e, canvas, ctx, 'main'));
                canvas.addEventListener('mouseup', () => stopDrawing('main'));
                canvas.addEventListener('mouseout', () => stopDrawing('main'));
                canvas.addEventListener('touchstart', (e) => startDrawing(e, canvas, ctx, 'main'), {passive: false});
                canvas.addEventListener('touchmove', (e) => draw(e, canvas, ctx, 'main'), {passive: false});
                canvas.addEventListener('touchend', () => stopDrawing('main'));
            }

            if (canvasAlat) {
                canvasAlat.addEventListener('mousedown', (e) => startDrawing(e, canvasAlat, ctxAlat, 'alat'));
                canvasAlat.addEventListener('mousemove', (e) => draw(e, canvasAlat, ctxAlat, 'alat'));
                canvasAlat.addEventListener('mouseup', () => stopDrawing('alat'));
                canvasAlat.addEventListener('mouseout', () => stopDrawing('alat'));
                canvasAlat.addEventListener('touchstart', (e) => startDrawing(e, canvasAlat, ctxAlat, 'alat'), {passive: false});
                canvasAlat.addEventListener('touchmove', (e) => draw(e, canvasAlat, ctxAlat, 'alat'), {passive: false});
                canvasAlat.addEventListener('touchend', () => stopDrawing('alat'));
            }

            if (canvasGanti) {
                canvasGanti.addEventListener('mousedown', (e) => startDrawing(e, canvasGanti, ctxGanti, 'ganti'));
                canvasGanti.addEventListener('mousemove', (e) => draw(e, canvasGanti, ctxGanti, 'ganti'));
                canvasGanti.addEventListener('mouseup', () => stopDrawing('ganti'));
                canvasGanti.addEventListener('mouseout', () => stopDrawing('ganti'));
                canvasGanti.addEventListener('touchstart', (e) => startDrawing(e, canvasGanti, ctxGanti, 'ganti'), {passive: false});
                canvasGanti.addEventListener('touchmove', (e) => draw(e, canvasGanti, ctxGanti, 'ganti'), {passive: false});
                canvasGanti.addEventListener('touchend', () => stopDrawing('ganti'));
            }
        }

        function getMousePos(e, cv) {
            const rect = cv.getBoundingClientRect();
            if (e.touches && e.touches.length > 0) {
                return { x: e.touches[0].clientX - rect.left, y: e.touches[0].clientY - rect.top };
            }
            return { x: e.clientX - rect.left, y: e.clientY - rect.top };
        }
        function startDrawing(e, cv, context, which) {
            if (e.type === 'touchstart') e.preventDefault();
            if (which === 'main') isDrawing = true;
            else if (which === 'alat') isDrawingAlat = true;
            else if (which === 'ganti') isDrawingGanti = true;
            const pos = getMousePos(e, cv);
            context.beginPath();
            context.moveTo(pos.x, pos.y);
        }
        function draw(e, cv, context, which) {
            const drawingFlag = which === 'main' ? isDrawing : (which === 'alat' ? isDrawingAlat : isDrawingGanti);
            if (!drawingFlag) return;
            if (e.type === 'touchmove') e.preventDefault();
            const pos = getMousePos(e, cv);
            context.lineTo(pos.x, pos.y);
            context.stroke();
        }
        function stopDrawing(which) {
            if (which === 'main' && isDrawing) { ctx.closePath(); isDrawing = false; }
            if (which === 'alat' && isDrawingAlat) { ctxAlat.closePath(); isDrawingAlat = false; }
            if (which === 'ganti' && isDrawingGanti) { ctxGanti.closePath(); isDrawingGanti = false; }
        }
        function clearSignature() { ctx.clearRect(0, 0, canvas.width, canvas.height); }
        function clearSignatureAlat() { ctxAlat.clearRect(0, 0, canvasAlat.width, canvasAlat.height); }
        function clearSignatureGanti() { ctxGanti.clearRect(0, 0, canvasGanti.width, canvasGanti.height); }
        function isCanvasBlank(cv) {
            const blank = document.createElement('canvas');
            blank.width = cv.width;
            blank.height = cv.height;
            return cv.toDataURL() === blank.toDataURL();
        }

