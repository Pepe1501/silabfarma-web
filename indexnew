        // [FITUR] Pengembalian Alat Sebagian (Partial Return)
        // Membuka form kecil untuk mencatat berapa unit yang dikembalikan
        // SEKARANG (bisa sebagian dari sisa, atau sekaligus semua sisa).
        function promptPengembalianSebagian(rowIndex) {
            const record = LOAN_DATA.find(r => r.rowIndex === rowIndex);
            if (!record) return;

            const jumlahDikembalikan = record.jumlahDikembalikan || 0;
            const sisa = record.jumlah - jumlahDikembalikan;
            if (sisa <= 0) return;

            Swal.fire({
                title: 'Update Pengembalian Alat',
                html: `
                    <div class="text-left text-sm space-y-1 mb-2">
                        <p><b>${record.peminjam}</b> &middot; ${record.alat}</p>
                        <p class="text-xs text-slate-500">Total dipinjam: <b>${record.jumlah}</b> &middot; Sudah dikembalikan: <b>${jumlahDikembalikan}</b> &middot; Sisa: <b class="text-rose-600">${sisa}</b></p>
                    </div>`,
                input: 'number',
                inputLabel: `Jumlah yang dikembalikan sekarang (maks. ${sisa})`,
                inputValue: sisa,
                inputAttributes: { min: 1, max: sisa, step: 1 },
                showCancelButton: true,
                confirmButtonColor: '#059669',
                cancelButtonColor: '#94a3b8',
                confirmButtonText: 'Simpan',
                cancelButtonText: 'Batal',
                inputValidator: (value) => {
                    const v = parseInt(value, 10);
                    if (!value || isNaN(v) || v < 1) return 'Masukkan jumlah yang valid.';
                    if (v > sisa) return `Jumlah tidak boleh melebihi sisa (${sisa}).`;
                }
            }).then((result) => {
                if (!result.isConfirmed) return;
                const jumlahKembali = parseInt(result.value, 10);

                gsRun('markPengembalianSebagian', rowIndex, jumlahKembali)
                    .then((res) => {
                        const sisaBaru = (res && typeof res.sisa === 'number') ? res.sisa : 0;
                        Swal.fire({
                            toast: true, position: 'top-end', icon: 'success',
                            title: sisaBaru > 0
                                ? `Dicatat ${jumlahKembali} kembali, sisa ${sisaBaru} unit belum kembali`
                                : 'Semua alat sudah dikembalikan — status: Selesai',
                            showConfirmButton: false, timer: 2500
                        });
                        fetchData(false);
                    })
                    .catch((err) => {
                        Swal.fire('Gagal Memperbarui', (err && err.message) || String(err), 'error');
                    });
            });
        }

