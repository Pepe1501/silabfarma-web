        // [FIX 16 Agustus 2026] Mengubah string ISO "yyyy-MM-dd" menjadi objek
        // Date lokal (jam 00:00 waktu browser). Dipakai untuk perhitungan
        // keterlambatan yang AKURAT dan tidak tergantung nama bulan/kapitalisasi.
        function parseISODateLocal(iso) {
            if (!iso) return null;
            const parts = String(iso).trim().split('-');
            if (parts.length !== 3) return null;
            const y = parseInt(parts[0], 10), m = parseInt(parts[1], 10), d = parseInt(parts[2], 10);
            if (!y || !m || !d) return null;
            const dt = new Date(y, m - 1, d);
            return isNaN(dt.getTime()) ? null : dt;
        }

        // Cek apakah tanggal kembali sudah lewat dari hari ini dan masih ada
        // sisa alat yang belum dikembalikan.
        //
        // [FIX 16 Agustus 2026] AKAR MASALAH "status Terlambat/Dipinjam tidak
        // konsisten": sebelumnya fungsi ini SELALU mem-parsing teks
        // "dd Bulan yyyy" (record.tanggalKembali). Teks ini bisa berasal dari
        // ketikan bebas mahasiswa di form lama, sehingga rawan typo/beda
        // kapitalisasi ("agustus" vs "Agustus") yang membuat parsing gagal
        // secara DIAM-DIAM dan status keliru dianggap "belum terlambat".
        //
        // Sekarang fungsi ini MENGUTAMAKAN record.tanggalKembaliISO
        // (format yyyy-MM-dd yang selalu valid, karena form sekarang memakai
        // date picker asli browser). Parser teks lama hanya dipakai sebagai
        // FALLBACK untuk baris data LAMA yang belum memiliki tanggalKembaliISO.
        function isPinjamTerlambat(record) {
            if (record.status === 'Sudah Dikembalikan') return false;
            const sisa = record.jumlah - (record.jumlahDikembalikan || 0);
            if (sisa <= 0) return false;

            let kembaliDate = parseISODateLocal(record.tanggalKembaliISO);

            if (!kembaliDate) {
                // Fallback untuk data lama yang belum punya tanggalKembaliISO
                if (!record.tanggalKembali) return false;
                const bulanMap = {Januari:0,Februari:1,Maret:2,April:3,Mei:4,Juni:5,Juli:6,Agustus:7,September:8,Oktober:9,November:10,Desember:11};
                const parts = record.tanggalKembali.trim().split(' ');
                if (parts.length < 3 || !(parts[1] in bulanMap)) return false;
                kembaliDate = new Date(parseInt(parts[2], 10), bulanMap[parts[1]], parseInt(parts[0], 10));
                if (isNaN(kembaliDate.getTime())) return false;
            }

            const today = new Date();
            today.setHours(0, 0, 0, 0);
            kembaliDate.setHours(0, 0, 0, 0);
            return today > kembaliDate;
        }

        // [DIPERJELAS] Badge status pengembalian alat. Membedakan tegas antara:
        // - Selesai (semua unit sudah kembali) -> hijau + ikon centang
        // - Sebagian Dikembalikan (masih ada sisa) -> kuning + pecahan x/y
        // - Sebagian & Terlambat -> merah + pecahan x/y
        // - Terlambat (belum kembali sama sekali & lewat tanggal) -> merah
        // - Dipinjam (masih dalam masa pinjam, belum ada yang kembali) -> biru
        function getStatusBadgeAlat(loan) {
            const jumlahDikembalikan = loan.jumlahDikembalikan || 0;
            const sisa = loan.jumlah - jumlahDikembalikan;
            const terlambat = isPinjamTerlambat(loan);

            if (sisa <= 0) {
                return '<span class="bg-emerald-100 text-emerald-700 px-2.5 py-1 rounded-md text-[10px] font-bold border border-emerald-200"><i class="fa-solid fa-circle-check mr-1"></i>Selesai (Semua Kembali)</span>';
            }
            if (jumlahDikembalikan > 0) {
                if (terlambat) {
                    return `<span class="bg-rose-100 text-rose-700 px-2.5 py-1 rounded-md text-[10px] font-bold border border-rose-200"><i class="fa-solid fa-triangle-exclamation mr-1"></i>Sebagian &amp; Terlambat (${jumlahDikembalikan}/${loan.jumlah})</span>`;
                }
                return `<span class="bg-amber-100 text-amber-700 px-2.5 py-1 rounded-md text-[10px] font-bold border border-amber-200"><i class="fa-solid fa-hourglass-half mr-1"></i>Sebagian Dikembalikan (${jumlahDikembalikan}/${loan.jumlah})</span>`;
            }
            if (terlambat) {
                return '<span class="bg-rose-100 text-rose-700 px-2.5 py-1 rounded-md text-[10px] font-bold border border-rose-200"><i class="fa-solid fa-triangle-exclamation mr-1"></i>Terlambat</span>';
            }
            return '<span class="bg-sky-100 text-sky-700 px-2.5 py-1 rounded-md text-[10px] font-bold border border-sky-200"><i class="fa-solid fa-clock mr-1"></i>Dipinjam</span>';
        }

