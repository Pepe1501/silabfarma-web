        function formatPhoneForWa(telp) {
            if (!telp) return '';
            let digits = String(telp).replace(/[^0-9]/g, '');
            if (!digits) return '';
            if (digits.startsWith('0')) digits = '62' + digits.substring(1);
            else if (!digits.startsWith('62')) digits = '62' + digits;
            return digits;
        }

        function buildWaLink(telp, message) {
            const phone = formatPhoneForWa(telp);
            if (!phone) return '';
            return 'https://wa.me/' + phone + '?text=' + encodeURIComponent(message);
        }

